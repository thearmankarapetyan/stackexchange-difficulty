# Authored-text consistency across operating systems.
* text=auto eol=lf

# Explicit binary-deliverable declarations prevent Git text merges.
*.xlsx binary
*.pdf binary
*.png binary

# Verified examples preserve source whitespace inside copied post bodies.
data/examples/*.xml -diff
data/examples/pilot_dump/*.xml -diff
data/examples/characteristics_pilot.tsv -diff
data/examples/characteristics_pilot_validation.tsv -diff
